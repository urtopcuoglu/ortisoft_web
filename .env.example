# Bu dosyayı kopyalayıp `.env.local` olarak kaydet ve gerçek değerleri gir.
# .env.local asla commit edilmez (bkz. .gitignore).

# ── Supabase PostgreSQL ──────────────────────────────────────────────
# Runtime (uygulama) bağlantısı — Supabase Dashboard > Project Settings > Database
# > Connection string > Transaction pooler (port 6543, pgbouncer=true)
# Not: sslmode=no-verify gerekli — Supabase pooler'ı kendi (self-signed) kök CA'sını
# kullanıyor ve `pg` sürücüsünün yeni sürümlerinde sslmode=require artık tam sertifika
# doğrulaması (verify-full) anlamına geliyor, bu da bağlantıyı reddediyor.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"

# Migration bağlantısı — aynı sayfada Session pooler / direct connection (port 5432).
# SADECE Prisma CLI (migrate/db pull/studio) tarafından kullanılır — uygulama runtime'ı
# lib/prisma.ts üzerinden ayrıca DATABASE_URL'i (pooler) kullanır.
# Not: Bu bağlantı Prisma'nın kendi (Rust) motoru üzerinden kurulur, `require` burada
# klasik anlamıyla (şifrele, CA doğrulama) çalışır — no-verify GEREKMEZ.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth (Faz 1) ─────────────────────────────────────────────────────
# Oturum JWT'lerini imzalamak için rastgele bir sır — üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="[RANDOM-32-BYTE-BASE64]"

# İlk admin kullanıcısı — sadece `npm run db:seed` çalıştırırken bir kerelik kullanılır.
# Seed'den sonra ADMIN_PASSWORD'ü değiştirip seed'i tekrar çalıştırman önerilir.
ADMIN_EMAIL="admin@ornek.com"
ADMIN_PASSWORD="[GUCLU-BIR-SIFRE]"
ADMIN_NAME="Admin"

# ── Supabase Storage (CV yükleme) ───────────────────────────────────────
# Supabase Dashboard > Project Settings > API sayfasından.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# ── Resend (mesaj yanıtlarının otomatik e-posta gönderimi) ─────────────
# Opsiyonel — tanımlı değilse admin panelinde mailto: taslağı yedeği kullanılır.
# resend.com'da hesap açıp API key oluştur: Dashboard > API Keys.
RESEND_API_KEY="[RESEND-API-KEY]"
# Gerçek müşterilere e-posta gönderebilmek için Resend'de kendi alan adını
# (ör. ortisoft.com.tr) doğrulaman gerekir — doğrulanmadan sadece Resend
# hesabına kayıtlı e-postaya test gönderimi yapılabilir (onboarding@resend.dev).
RESEND_FROM_EMAIL="Ortisoft <noreply@ortisoft.com.tr>"
