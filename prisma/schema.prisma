// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Faz 0 — Temel modeller (User + AuditLog)
// Sonraki fazlarda modules/<alan> için yeni modeller eklenecek.
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String
  name                   String
  role                   UserRole               @default(EDITOR)
  // Personel bilgileri (Faz 4 — Kullanıcı Yönetimi paneli). Login ile ilgisi
  // yok, sadece bilgi amaçlı — bkz. modules/users.
  title                  String?
  department             String?
  personalPhone          String?
  companyPhone           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  auditLogs              AuditLog[]
  messageReplies         MessageReply[]
  blogPosts              BlogPost[]
  // "Ekibe ekle" ile oluşturulan public TeamMember kaydına bağlantı (varsa).
  teamMember             TeamMember?
  // Rehber/CRM modülünde "İlgili Kişi" olarak atanan kayıtlar (bkz. modules/guide).
  guideContacts          GuideContact[]
  // CRM: oluşturduğum görüşme/toplantı notları (bkz. modules/crm).
  clientMeetings         ClientMeeting[]
  // Şifre sıfırlama — kendi taleplerim + (ADMIN ise) onayladığım/reddettiğim talepler.
  passwordResetRequests  PasswordResetRequest[] @relation("PasswordResetRequests")
  resolvedPasswordResets PasswordResetRequest[] @relation("ResolvedPasswordResets")

  // Görev Yönetimi (bkz. modules/tasks) — bana atanan görevler/alt görevler/
  // talepler, benim yaptığım atamalar, oluşturduğum görevler/talepler/yorumlar,
  // ve bana gelen bildirimler.
  taskAssignments            TaskAssignee[]        @relation("TaskAssignments")
  taskAssignmentsMade        TaskAssignee[]        @relation("TaskAssignmentsBy")
  taskSubtaskAssignments     TaskSubtaskAssignee[] @relation("TaskSubtaskAssignments")
  taskSubtaskAssignmentsMade TaskSubtaskAssignee[] @relation("TaskSubtaskAssignmentsBy")
  taskRequestAssignments     TaskRequestAssignee[] @relation("TaskRequestAssignments")
  createdTasks               Task[]
  taskComments               TaskComment[]
  createdTaskRequests        TaskRequest[]
  notifications              Notification[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// Faz 2 — İçerik modülleri: Hakkımızda + Hizmetler
// `locale` alanı şimdiden eklendi (Faz 4 çoklu dil desteği için), varsayılan "tr".
// `icon`/`colorTheme` alanları serbest metin DEĞİL — kod tarafında sabit bir
// eşleme (lib/icon-map.tsx, lib/color-theme.ts) üzerinden render edilir; admin
// panelinden ham Tailwind class'ı/keyfi kod yazılmasını engellemek içindir.
// ─────────────────────────────────────────────────────────

// Tek satırlık (singleton) sayfa metinleri — her zaman upsert edilir.
model AboutContent {
  id           String   @id @default(cuid())
  locale       String   @default("tr")
  heroTitle    String   @default("Hakkımızda")
  heroSubtitle String
  aboutText    String
  missionText  String
  visionText   String
  updatedAt    DateTime @updatedAt

  @@unique([locale])
  @@map("about_content")
}

model TeamMember {
  id           String   @id @default(cuid())
  locale       String   @default("tr")
  name         String
  role         String
  bio          String
  photoUrl     String?
  colorTheme   String   @default("blue")
  linkedinUrl  String?
  specialties  Json
  sortOrder    Int      @default(0)
  // Kullanıcı Yönetimi panelinden "Ekibe ekle" ile oluşturulmuşsa bağlı hesap.
  // Hesap silinirse bağlantı kopar (SetNull) ama public bio kaydı kalmaya
  // devam eder — bilinçli tercih, bkz. modules/users/actions.ts.
  linkedUser   User?    @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  linkedUserId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("team_members")
}

model Service {
  id              String   @id @default(cuid())
  locale          String   @default("tr")
  slug            String
  icon            String
  tag             String
  title           String
  description     String
  colorTheme      String   @default("blue")
  sortOrder       Int      @default(0)
  // Alt hizmetler — dinamik/sonsuz sayıda eklenebilir, eski `features` metin
  // listesinin yerini alır. Şekli: { label: string, description: string,
  // price: number|null }[]. label+description public /services sayfasında
  // gösterilir, price SADECE admin panelinde görünür (bkz. modules/services/schema.ts).
  subServices     Json
  pricingCurrency String   @default("TRY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("services")
}

model Reference {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  clientName  String
  description String
  logoUrl     String?
  projectLink String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("references")
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum MessageStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

// İletişim formundan gelen mesajlar — herkes (girişsiz) oluşturabilir,
// sadece admin görüntüleyip yanıtlayabilir.
enum MessagePurpose {
  INFO
  SUPPORT
  SERVICE
  PARTNERSHIP
  CV
}

model ContactMessage {
  id          String         @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  service     String?
  message     String
  purpose     MessagePurpose @default(INFO)
  // CV başvurusu (purpose=CV) — Supabase Storage'daki dosya yolu (private bucket,
  // indirme için her seferinde imzalı URL üretilir) ve orijinal dosya adı.
  cvFilePath  String?
  cvFileName  String?
  kvkkConsent Boolean        @default(false)
  status      MessageStatus  @default(NEW)
  source      String         @default("contact_form")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  replies     MessageReply[]

  @@index([status])
  @@index([purpose])
  @@map("contact_messages")
}

model MessageReply {
  id             String         @id @default(cuid())
  message        ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId      String
  body           String
  sentBy         User?          @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentById       String?
  sentAt         DateTime       @default(now())
  // Resend üzerinden otomatik gönderildiyse dönen mesaj ID'si — doluysa
  // "gerçekten gönderildi", boşsa admin sadece mailto: taslağı kullandı demektir.
  emailMessageId String?

  @@index([messageId])
  @@map("message_replies")
}

enum ProjectStatus {
  COMING_SOON
  IN_DEVELOPMENT
  ACTIVE
}

// Ortisoft'un kendi ürünleri / hibe destekli projeleri (müşteri vaka çalışmaları DEĞİL).
model Project {
  id           String        @id @default(cuid())
  locale       String        @default("tr")
  slug         String
  title        String
  status       ProjectStatus @default(COMING_SOON)
  fundingLabel String
  tagline      String
  description  String
  tags         Json
  icon         String
  colorTheme   String        @default("blue")
  features     Json
  techStack    Json?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("projects")
}

model CareerPosting {
  id             String       @id @default(cuid())
  locale         String       @default("tr")
  slug           String
  title          String
  description    String
  requirements   Json
  location       String
  employmentType String
  applyEmail     String
  status         CareerStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
  @@map("career_postings")
}

// ─────────────────────────────────────────────────────────
// Sözleşme yönetimi — KVKK, Gizlilik, Çerez vb. Footer'da listelenir,
// her biri /contracts/[slug] sayfasına sahiptir. Zengin metin (Tiptap HTML)
// içeriği SADECE admin tarafından yazılır (tek admin hesabı — public kullanıcı
// girdisi değildir), bu yüzden ayrıca sanitize edilmez.
// ─────────────────────────────────────────────────────────
model Contract {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

// ─────────────────────────────────────────────────────────
// Sayfa yönetimi — sabit bir sayfa listesi (kod içinde route'ları zaten var),
// her satır sadece "coming soon" durumunu tutar. Yeni sayfa admin panelinden
// eklenemez/silinemez, sadece mevcut sayfaların görünürlüğü aç/kapa yapılır.
// ─────────────────────────────────────────────────────────
model SitePage {
  key            String   @id
  label          String
  comingSoon     Boolean  @default(false)
  // Sayfa bazlı SEO — public sayfanın generateMetadata()'sı bunları okur.
  // Boşsa sayfa kendi statik/dinamik varsayılanına düşer (bkz. ilgili page.tsx).
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  updatedAt      DateTime @updatedAt

  @@map("site_pages")
}

// Header/Footer'daki iletişim bilgileri ve sosyal medya linkleri — admin
// panelinden (/admin/site-settings) düzenlenir. Tek satırlık (singleton)
// bir tablo; id sabit "singleton" değerini taşır. Menü linkleri (yapısal,
// i18n'e bağlı) ve tagline/CTA metinleri (i18n dictionary'de) bu kapsamda
// DEĞİL — sadece gerçekten hardcoded olan iletişim/sosyal alanlar burada.
model SiteSettings {
  id            String   @id @default("singleton")
  contactEmail  String?
  contactPhone1 String?
  contactPhone2 String?
  address       String?
  addressMapUrl String?
  linkedinUrl   String?
  twitterUrl    String?
  githubUrl     String?
  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// SEO alanları (seoTitle/seoDescription/focusKeyword) admin editöründeki
// SEO Analiz Aracı (SERP önizleme + karakter/anahtar kelime kontrolü) için —
// bkz. plan dokümanı Bölüm 3.4. generateMetadata() ile gerçek <head>'e yansır.
model BlogPost {
  id             String     @id @default(cuid())
  locale         String     @default("tr")
  slug           String
  title          String
  excerpt        String
  content        String
  coverImage     String?
  tags           Json
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  authorId       String?
  author         User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
  @@map("blog_posts")
}

// ─────────────────────────────────────────────────────────
// Rehber modülü (plan dışı, kullanıcı isteği) — firma/kişi kartvizit defteri.
// İşletme kategorisi serbest metin değil, admin panelinden "yeni kategori
// ekle" ile büyüyen bir liste (GuideCategory); ilişki türü ise sabit bir
// enum (kullanıcı tarafından tanımlı, sabit 8 değer).
// ─────────────────────────────────────────────────────────
model GuideCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  contacts  GuideContact[]

  @@map("guide_categories")
}

enum GuideRelationType {
  COZUM_ORTAGI
  TEDARIKCI
  POTANSIYEL_MUSTERI
  AKTIF_MUSTERI
  PASIF_MUSTERI
  YETKILI_TEKNIK_SERVIS
  MALI_MUHASEBE
  DESTEK
}

model GuideContact {
  id               String @id @default(cuid())
  // Firma adı.
  companyName      String
  // Firma tarafındaki yetkili/irtibat kişisi (serbest metin — bizim
  // kullanıcılarımızdan biri DEĞİL, bkz. relatedUser).
  authorizedPerson String

  category   GuideCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  phone   String
  address String?
  email   String
  website String?

  // "İlgili kişi" — bu kaydı takip eden bizim ekipten biri (users listesi).
  relatedUser   User?   @relation(fields: [relatedUserId], references: [id], onDelete: SetNull)
  relatedUserId String?

  relationType GuideRelationType

  // Potansiyel müşteri AKTIF_MUSTERI'ye geçtiğinde otomatik doldurulur (bkz.
  // modules/crm/actions.ts) — "ne zaman aktif portföye girdi" raporlaması için.
  becameActiveAt DateTime?

  // Kayıt tarihi — modalde alan olarak İSTENMİYOR, kayıt anında sunucu
  // tarafında otomatik basılır; listede gün_ay_yıl formatında gösterilir
  // (bkz. lib/utils.ts formatGunAyYil). Gerçek DateTime olarak tutulur ki
  // tabloda tarihe göre asc/desc sıralama doğru çalışsın.
  recordDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CRM alt-kayıtları — bkz. modules/crm. Silme Restrict: bir firma kaydı,
  // altında ödeme/sözleşme/teklif geçmişi varken yanlışlıkla silinemesin
  // (bilinçli tercih, "gerçekten sil" yerine relationType'ı PASIF_MUSTERI'ye
  // çekmek beklenen kullanım).
  meetings   ClientMeeting[]
  proposals  Proposal[]
  agreements ClientAgreement[]
  payments   Payment[]

  @@index([categoryId])
  @@index([relatedUserId])
  @@index([relationType])
  @@map("guide_contacts")
}

// ─────────────────────────────────────────────────────────
// CRM genişletmesi (2026-09-01, plan dışı) — Rehber'in ("GuideContact")
// üstüne inşa edilir: görüşme notları, teklifler, sözleşmeler, ödemeler.
// Model adı bilinçli olarak "Contract" DEĞİL "ClientAgreement" — o isim
// zaten footer sözleşmeleri (KVKK/Gizlilik) için dolu, bkz. yukarısı.
// ─────────────────────────────────────────────────────────

enum MeetingType {
  EMAIL
  IN_PERSON
  PHONE
}

model ClientMeeting {
  id        String       @id @default(cuid())
  contact   GuideContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactId String

  type       MeetingType
  occurredAt DateTime    @default(now())
  notes      String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([type])
  @@map("client_meetings")
}

enum ProposalStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Proposal {
  id        String       @id @default(cuid())
  contact   GuideContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactId String

  title       String
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("TRY")
  status      ProposalStatus @default(SENT)
  sentAt      DateTime       @default(now())
  respondedAt DateTime?
  // Teklif dosyası (PDF vb.) — Supabase Storage'da, CV yüklemedeki gibi.
  fileUrl     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([status])
  @@map("proposals")
}

model ClientAgreement {
  id        String       @id @default(cuid())
  contact   GuideContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactId String

  title     String
  fileUrl   String?
  signedAt  DateTime?
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("client_agreements")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentPeriod {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

model Payment {
  id        String       @id @default(cuid())
  contact   GuideContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactId String

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("TRY")
  method   PaymentMethod
  period   PaymentPeriod @default(ONE_TIME)
  // Bir sonraki ödeme vadesi (planlanan/beklenen).
  dueDate  DateTime?
  // Fiilen alındıysa — null ise henüz tahsil edilmemiş demektir.
  paidAt   DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([dueDate])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// "Şifremi Unuttum" akışı — mail sunucusu YOK, bu yüzden self-servis değil:
// kullanıcı /admin/forgot-password'dan talep açar, bir ADMIN admin panelinden
// (/admin/password-resets) görüp onaylar/reddeder. Onaylanınca tek kullanımlık,
// süreli bir token üretilir; admin bu linki kullanıcıya başka bir kanaldan
// (telefon/WhatsApp) elle iletir — bkz. modules/auth/actions.ts.
// ─────────────────────────────────────────────────────────
enum PasswordResetStatus {
  PENDING
  APPROVED
  DISMISSED
  USED
}

model PasswordResetRequest {
  id     String  @id @default(cuid())
  // Talep formunda girilen e-posta — kullanıcı bulunamasa da (enumeration'ı
  // önlemek için) aynı jenerik mesaj döner, ama kayıt SADECE eşleşen bir
  // User varsa oluşturulur (bkz. resolveUserForReset).
  email  String
  user   User?   @relation("PasswordResetRequests", fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  status         PasswordResetStatus @default(PENDING)
  token          String?             @unique
  tokenExpiresAt DateTime?

  requestedAt  DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   User?     @relation("ResolvedPasswordResets", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?

  @@index([status])
  @@map("password_reset_requests")
}

// ─────────────────────────────────────────────────────────
// Influencer modülü (Rehber/CRM sekmesi, 2026-09-08, plan dışı) — işbirliği
// yapılan/yapılabilecek influencer'ların iletişim + sosyal medya hesap
// bilgilerini tutar. Platform listesi serbest metin değil, GuideCategory'deki
// gibi admin panelinden "+ yeni platform ekle" ile büyüyen bir liste
// (InfluencerPlatform); `slug` alanı profil linki/QR üretiminde ("instagram"/
// "tiktok" eşleşmesi, bkz. lib/social-platform.ts) kullanılır.
// ─────────────────────────────────────────────────────────
model InfluencerPlatform {
  id        String                    @id @default(cuid())
  name      String                    @unique
  slug      String                    @unique
  createdAt DateTime                  @default(now())
  accounts  InfluencerSocialAccount[]

  @@map("influencer_platforms")
}

// İçerik kategorisi — GuideCategory ile aynı desen: sabit bir enum DEĞİL,
// admin panelinden "+ yeni kategori ekle" ile serbestçe büyüyen bir liste
// (bkz. modules/influencer/schema.ts#NEW_CONTENT_CATEGORY_VALUE). "Life
// style", "Spor", "Yoga", "Yemek-Tarif" gibi manuel etiketler için.
model InfluencerContentCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  influencers Influencer[]

  @@map("influencer_content_categories")
}

model Influencer {
  id         String                    @id @default(cuid())
  firstName  String?
  lastName   String?
  email      String?
  phone      String?
  address    String?
  // Kayıt tarihi — modalde alan olarak İSTENMİYOR, kayıt anında sunucu
  // tarafında otomatik basılır (bkz. GuideContact.recordDate ile aynı desen,
  // lib/utils.ts#formatGunAyYil ile gün_ay_yıl olarak gösterilir).
  recordDate DateTime                  @default(now())
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  accounts   InfluencerSocialAccount[]

  // Takipçi bazlı Nano/Mikro/Makro/Mega ayrımı burada bir alan DEĞİL — DB'de
  // saklanmaz, toplam takipçiden anlık türetilir (bkz.
  // components/admin/influencer/types.ts#influencerTier) ki eşikler
  // değiştiğinde geçmiş kayıtlar yeniden hesaplanmasın diye migration
  // gerekmesin.
  contentCategory   InfluencerContentCategory? @relation(fields: [contentCategoryId], references: [id], onDelete: SetNull)
  contentCategoryId String?

  @@index([recordDate])
  @@index([contentCategoryId])
  @@map("influencers")
}

// Bir influencer'ın birden fazla platformda hesabı olabilir (Instagram +
// TikTok gibi) — bu yüzden ayrı bir tabloda (bire-çok). `username` formdaki
// TEK zorunlu alan (bkz. modules/influencer/schema.ts); `profileUrl` boş
// bırakılırsa bilinen platformlar için otomatik türetilir (QR + link için).
model InfluencerSocialAccount {
  id            String             @id @default(cuid())
  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId  String
  platform      InfluencerPlatform @relation(fields: [platformId], references: [id])
  platformId    String
  username      String
  profileUrl    String?
  followerCount Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([influencerId])
  @@index([platformId])
  @@map("influencer_social_accounts")
}

// ─────────────────────────────────────────────────────────
// Görev Yönetimi (Trello-lite, CRM'in 3. sekmesi — "Görev Yönetimi", 2026-09-11,
// plan dışı). Kanban panosu (sütun→görev, sürükle-bırak) + Zaman Çizelgesi
// görünümü aynı Task verisini paylaşır. Sıralama (Task.order/TaskColumn.order/
// TaskSubtask.order) "sparse float" tekniğiyle tutulur: yeni kayıtlar 1000'er
// aralıklı, iki kayıt arası taşımada (prev+next)/2 — her sürüklemede tüm
// sütunu yeniden numaralamamak için (bkz. modules/tasks/actions.ts#
// computeSparseOrder). Silme yerine arşivleme felsefesi GuideContact'taki
// "PASIF_MUSTERI'ye çek" yaklaşımıyla tutarlı: Task hard-delete edilmez.
// ─────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRequestStatus {
  PLANLANDI
  TAMAMLANDI
  IPTAL
}

// Bildirim çanı — mevcut global NotificationsBell (AuditLog tabanlı, kişiye
// özel değil) bu iş için yetersiz: burada belirli kullanıcıya, okundu
// durumu sunucuda kalıcı olan hedefli bildirimler gerekiyor, bu yüzden
// bilinçli olarak ayrı bir Notification tablosu açılıyor.
enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMMENT
  TASK_COMMENT_REPLY
  TASK_REQUEST_ASSIGNED
  TASK_REQUEST_UPDATED
}

// Kanban sütunları ("Yapılacak" vb.) — GuideCategory gibi admin-büyüyebilir
// bir liste, sabit bir enum DEĞİL; v1'de tam CRUD var (ekle/adlandır/
// sırala/arşivle). Arşivleme sadece içinde aktif görev yoksa izinli.
model TaskColumn {
  id        String   @id @default(cuid())
  name      String
  color     String?
  order     Float
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@map("task_columns")
}

// Etiket/kategori (kullanıcı bu iki kavramı eşitledi) — GuideCategory ile
// aynı resolve-or-create deseni, artı sabit bir renk paleti. Join tablosunda
// ekstra alan gerekmediği için implicit many-to-many kullanılıyor.
model TaskLabel {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
  tasks     Task[]

  @@map("task_labels")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  // Zengin metin (RichTextEditor/Tiptap) — blog içeriğiyle aynı desen.
  description String?
  priority    TaskPriority @default(MEDIUM)

  column   TaskColumn @relation(fields: [columnId], references: [id])
  columnId String
  // Sütun içi sıra — bkz. dosya başı açıklama.
  order    Float

  // Hard delete yok — arşivlenen görev panodan kalkar, Zaman Çizelgesi/geçmiş
  // sorgularında includeArchived:true ile hâlâ erişilebilir.
  archived   Boolean   @default(false)
  archivedAt DateTime?

  startAt DateTime?
  dueAt   DateTime?

  // Görevi oluşturan/ilk atayan kişi. Kim kime atadı bilgisinin asıl kaynağı
  // TaskAssignee.assignedById'dir (görev yeniden atandıkça değişebilir);
  // burası sabit "oluşturan" bilgisi.
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels    TaskLabel[]
  assignees TaskAssignee[]
  subtasks  TaskSubtask[]
  comments  TaskComment[]
  requests  TaskRequest[]

  @@index([columnId])
  @@index([archived])
  @@index([dueAt])
  @@map("tasks")
}

// Görev-seviyesi atama. Cascade (User silinirse satır da silinir) — bilinçli
// olarak diğer User ilişkilerinden (genelde SetNull) farklı: bu satırın tek
// anlamı "bu kullanıcı atanmış", kullanıcı yoksa satırın da anlamı kalmıyor.
// assignedById ise SetNull — "kim atadı" geçmiş bilgisi atayan silinse de kalmalı.
model TaskAssignee {
  id           String   @id @default(cuid())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String
  user         User     @relation("TaskAssignments", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  assignedBy   User?    @relation("TaskAssignmentsBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  assignedAt   DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

// Alt görev — bilinçli olarak Task'ın kendine referansı (self-relation)
// DEĞİL, hafif bir model. Kullanıcı sadece alt-görev bazlı ATAMA istedi,
// alt görevin kendi etiketi/yorumu/sütunu olmasını istemedi (Trello'nun
// checklist item mantığıyla birebir) — self-relation gereksiz karmaşıklık
// ve sınırsız iç içe alt-görev riski getirirdi.
model TaskSubtask {
  id        String    @id @default(cuid())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  title     String
  isDone    Boolean   @default(false)
  order     Float
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignees TaskSubtaskAssignee[]

  @@index([taskId])
  @@map("task_subtasks")
}

model TaskSubtaskAssignee {
  id           String      @id @default(cuid())
  subtask      TaskSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  subtaskId    String
  user         User        @relation("TaskSubtaskAssignments", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  assignedBy   User?       @relation("TaskSubtaskAssignmentsBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  assignedAt   DateTime    @default(now())

  @@unique([subtaskId, userId])
  @@map("task_subtask_assignees")
}

// Yorumlar — self-relation ile sonsuz iç içe yanıt (parentCommentId).
// Soft delete: bir yorum silinse bile altındaki yanıt zinciri çalışmaya
// devam etsin diye hard delete edilmiyor; UI "Bu yorum silindi" placeholder'ı
// gösterip child reply'leri render etmeye devam eder. onDelete: Restrict
// self-relation'da sadece DB-seviyesi bir backstop — uygulama kodu hiçbir
// zaman hard delete denemiyor, bu yüzden pratikte hiç tetiklenmemeli.
model TaskComment {
  id              String        @id @default(cuid())
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  parent          TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  parentCommentId String?
  replies         TaskComment[] @relation("CommentReplies")
  body            String
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([taskId])
  @@index([parentCommentId])
  @@map("task_comments")
}

// Talep tipi ("Şirket Toplantısı", "Müşteri Ziyareti" vb.) — GuideCategory
// ile aynı admin-büyüyebilir liste deseni.
model TaskRequestType {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  requests  TaskRequest[]

  @@map("task_request_types")
}

// Görev içi ad-hoc, tarih/saat atanabilen "talep" ("şirket toplantısı
// oluştur" gibi) — sonradan güncellenebilir. scheduledAt her zaman dolu bir
// DateTime tutar; isAllDay=true ise saat girilmemiş demektir (gösterim/
// bildirimde saat atlanır). İleride ayrı bir Takvim modülünün ana veri
// kaynaklarından biri olacak şekilde tasarlandı (bkz. @@index([scheduledAt])).
model TaskRequest {
  id          String            @id @default(cuid())
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  type        TaskRequestType   @relation(fields: [typeId], references: [id])
  typeId      String
  title       String
  description String?
  scheduledAt DateTime
  isAllDay    Boolean           @default(false)
  status      TaskRequestStatus @default(PLANLANDI)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  assignees TaskRequestAssignee[]

  @@index([taskId])
  @@index([scheduledAt])
  @@map("task_requests")
}

// "Herkese ata" seçimi oluşturma anında MATERIALIZE edilir (o anki tüm
// kullanıcılar için satır açılır) — dinamik bir "ALL" flag'i, sonradan
// eklenen bir kullanıcının geçmiş talebi kapsayıp kapsamayacağı konusunda
// belirsizlik yaratırdı; materialize etmek bunu baştan önlüyor.
model TaskRequestAssignee {
  id            String      @id @default(cuid())
  taskRequest   TaskRequest @relation(fields: [taskRequestId], references: [id], onDelete: Cascade)
  taskRequestId String
  user          User        @relation("TaskRequestAssignments", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  assignedAt    DateTime    @default(now())

  @@unique([taskRequestId, userId])
  @@map("task_request_assignees")
}

// Kişiye özel, sunucu tarafında kalıcı okundu/okunmadı durumu olan bildirim
// — bkz. dosya başı açıklama (mevcut global NotificationsBell'den bilinçli
// ayrım). link, tıklanınca ilgili görevi doğrudan açan deep-link
// (/admin/crm?tab=tasks&task={id}) tutar.
model Notification {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  type       NotificationType
  title      String
  body       String?
  link       String?
  entityType String
  entityId   String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([entityType, entityId])
  @@map("notifications")
}
