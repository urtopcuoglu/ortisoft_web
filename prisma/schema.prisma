// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Faz 0 — Temel modeller (User + AuditLog)
// Sonraki fazlarda modules/<alan> için yeni modeller eklenecek.
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(EDITOR)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// Faz 2 — İçerik modülleri: Hakkımızda + Hizmetler
// `locale` alanı şimdiden eklendi (Faz 4 çoklu dil desteği için), varsayılan "tr".
// `icon`/`colorTheme` alanları serbest metin DEĞİL — kod tarafında sabit bir
// eşleme (lib/icon-map.tsx, lib/color-theme.ts) üzerinden render edilir; admin
// panelinden ham Tailwind class'ı/keyfi kod yazılmasını engellemek içindir.
// ─────────────────────────────────────────────────────────

// Tek satırlık (singleton) sayfa metinleri — her zaman upsert edilir.
model AboutContent {
  id           String   @id @default(cuid())
  locale       String   @default("tr")
  heroTitle    String   @default("Hakkımızda")
  heroSubtitle String
  aboutText    String
  missionText  String
  visionText   String
  updatedAt    DateTime @updatedAt

  @@unique([locale])
  @@map("about_content")
}

model TeamMember {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  name        String
  role        String
  bio         String
  photoUrl    String?
  colorTheme  String   @default("blue")
  linkedinUrl String?
  specialties Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("team_members")
}

model Service {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  slug        String
  icon        String
  tag         String
  title       String
  description String
  features    Json
  colorTheme  String   @default("blue")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("services")
}

model Reference {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  clientName  String
  description String
  logoUrl     String?
  projectLink String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("references")
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ProjectStatus {
  COMING_SOON
  IN_DEVELOPMENT
  ACTIVE
}

// Ortisoft'un kendi ürünleri / hibe destekli projeleri (müşteri vaka çalışmaları DEĞİL).
model Project {
  id           String        @id @default(cuid())
  locale       String        @default("tr")
  slug         String
  title        String
  status       ProjectStatus @default(COMING_SOON)
  fundingLabel String
  tagline      String
  description  String
  tags         Json
  icon         String
  colorTheme   String        @default("blue")
  features     Json
  techStack    Json?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("projects")
}

model CareerPosting {
  id             String       @id @default(cuid())
  locale         String       @default("tr")
  slug           String
  title          String
  description    String
  requirements   Json
  location       String
  employmentType String
  applyEmail     String
  status         CareerStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
  @@map("career_postings")
}
