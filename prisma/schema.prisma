// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Faz 0 — Temel modeller (User + AuditLog)
// Sonraki fazlarda modules/<alan> için yeni modeller eklenecek.
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           UserRole        @default(EDITOR)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  messageReplies MessageReply[]
  blogPosts      BlogPost[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// Faz 2 — İçerik modülleri: Hakkımızda + Hizmetler
// `locale` alanı şimdiden eklendi (Faz 4 çoklu dil desteği için), varsayılan "tr".
// `icon`/`colorTheme` alanları serbest metin DEĞİL — kod tarafında sabit bir
// eşleme (lib/icon-map.tsx, lib/color-theme.ts) üzerinden render edilir; admin
// panelinden ham Tailwind class'ı/keyfi kod yazılmasını engellemek içindir.
// ─────────────────────────────────────────────────────────

// Tek satırlık (singleton) sayfa metinleri — her zaman upsert edilir.
model AboutContent {
  id           String   @id @default(cuid())
  locale       String   @default("tr")
  heroTitle    String   @default("Hakkımızda")
  heroSubtitle String
  aboutText    String
  missionText  String
  visionText   String
  updatedAt    DateTime @updatedAt

  @@unique([locale])
  @@map("about_content")
}

model TeamMember {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  name        String
  role        String
  bio         String
  photoUrl    String?
  colorTheme  String   @default("blue")
  linkedinUrl String?
  specialties Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("team_members")
}

model Service {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  slug        String
  icon        String
  tag         String
  title       String
  description String
  features    Json
  colorTheme  String   @default("blue")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("services")
}

model Reference {
  id          String   @id @default(cuid())
  locale      String   @default("tr")
  clientName  String
  description String
  logoUrl     String?
  projectLink String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("references")
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum MessageStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

// İletişim formundan gelen mesajlar — herkes (girişsiz) oluşturabilir,
// sadece admin görüntüleyip yanıtlayabilir.
enum MessagePurpose {
  INFO
  SUPPORT
  SERVICE
  PARTNERSHIP
  CV
}

model ContactMessage {
  id           String          @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  service      String?
  message      String
  purpose      MessagePurpose  @default(INFO)
  // CV başvurusu (purpose=CV) — Supabase Storage'daki dosya yolu (private bucket,
  // indirme için her seferinde imzalı URL üretilir) ve orijinal dosya adı.
  cvFilePath   String?
  cvFileName   String?
  kvkkConsent  Boolean         @default(false)
  status       MessageStatus   @default(NEW)
  source       String          @default("contact_form")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  replies      MessageReply[]

  @@index([status])
  @@index([purpose])
  @@map("contact_messages")
}

model MessageReply {
  id        String         @id @default(cuid())
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  body      String
  sentBy    User?          @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentById  String?
  sentAt    DateTime       @default(now())

  @@index([messageId])
  @@map("message_replies")
}

enum ProjectStatus {
  COMING_SOON
  IN_DEVELOPMENT
  ACTIVE
}

// Ortisoft'un kendi ürünleri / hibe destekli projeleri (müşteri vaka çalışmaları DEĞİL).
model Project {
  id           String        @id @default(cuid())
  locale       String        @default("tr")
  slug         String
  title        String
  status       ProjectStatus @default(COMING_SOON)
  fundingLabel String
  tagline      String
  description  String
  tags         Json
  icon         String
  colorTheme   String        @default("blue")
  features     Json
  techStack    Json?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([locale, sortOrder])
  @@map("projects")
}

model CareerPosting {
  id             String       @id @default(cuid())
  locale         String       @default("tr")
  slug           String
  title          String
  description    String
  requirements   Json
  location       String
  employmentType String
  applyEmail     String
  status         CareerStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
  @@map("career_postings")
}

// ─────────────────────────────────────────────────────────
// Sözleşme yönetimi — KVKK, Gizlilik, Çerez vb. Footer'da listelenir,
// her biri /contracts/[slug] sayfasına sahiptir. Zengin metin (Tiptap HTML)
// içeriği SADECE admin tarafından yazılır (tek admin hesabı — public kullanıcı
// girdisi değildir), bu yüzden ayrıca sanitize edilmez.
// ─────────────────────────────────────────────────────────
model Contract {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

// ─────────────────────────────────────────────────────────
// Sayfa yönetimi — sabit bir sayfa listesi (kod içinde route'ları zaten var),
// her satır sadece "coming soon" durumunu tutar. Yeni sayfa admin panelinden
// eklenemez/silinemez, sadece mevcut sayfaların görünürlüğü aç/kapa yapılır.
// ─────────────────────────────────────────────────────────
model SitePage {
  key        String   @id
  label      String
  comingSoon Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("site_pages")
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// SEO alanları (seoTitle/seoDescription/focusKeyword) admin editöründeki
// SEO Analiz Aracı (SERP önizleme + karakter/anahtar kelime kontrolü) için —
// bkz. plan dokümanı Bölüm 3.4. generateMetadata() ile gerçek <head>'e yansır.
model BlogPost {
  id             String     @id @default(cuid())
  locale         String     @default("tr")
  slug           String
  title          String
  excerpt        String
  content        String
  coverImage     String?
  tags           Json
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  authorId       String?
  author         User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
  @@map("blog_posts")
}
